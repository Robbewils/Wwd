# Brevo > Settings > SMTP & API: gebruik de SMTP-login en SMTP-key (niet de API-key).
# Kopieer dit bestand naar .env en vul de waarden in. .env wordt genegeerd door Git.
BREVO_SMTP_LOGIN=je-smtp-login
BREVO_SMTP_KEY=plak-je-smtp-key-hier
BREVO_SMTP_PORT=587
BREVO_FROM_EMAIL=robbe.wils09@gmail.com
BREVO_FROM_NAME=Wilcotec
# Ontvanger voor meldingen bij nieuwe aanvragen; leeg laten gebruikt BREVO_FROM_EMAIL.
ADMIN_NOTIFICATION_EMAIL=
